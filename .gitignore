artifacts/comparison_v2_fixed/
artifacts/comparison_videos/
artifacts/heatmaps/
**/heatmaps/
results/

# =============================================================================
# Whitelist — keep small / important files inside otherwise-ignored patterns
# =============================================================================

# Keep calibration JSON and small CSVs inside artifacts
!artifacts/calibration.npz
!artifacts/**/*.json
!artifacts/**/*.csv
!artifacts/**/*.log

# Keep the v1_smoke and v2/v9 summary JSONs/CSVs (small)
!artifacts/v1_smoke/
!artifacts/v1_smoke/**
artifacts/v1_smoke/*.npz
artifacts/v1_smoke/heatmaps/

!artifacts/v2_held_out_eval/
!artifacts/v2_held_out_eval/**
artifacts/v2_held_out_eval/*.npz
artifacts/v2_held_out_eval/heatmaps/

!artifacts/v9_dreamgen/
!artifacts/v9_dreamgen/**
artifacts/v9_dreamgen/*.npz
artifacts/v9_dreamgen/heatmaps/

# Keep dreamgen_data code/config files (not checkpoints or generated output)
!dreamgen_data/
!dreamgen_data/ENV.md
!dreamgen_data/Makefile
!dreamgen_data/README.md
!dreamgen_data/generate.py
!dreamgen_data/postprocess.py
!dreamgen_data/profiles.py
!dreamgen_data/prompts.json
!dreamgen_data/requirements.txt
!dreamgen_data/setup.sh

# Keep .claude docs and skills; exclude machine-local state
!.claude/
!.claude/**
.claude/settings.local.json
.claude/worktrees/

# Test benchmark data — large reference images and cached results
test/

# Keep warp_score configs (already tracked by default but ensure not ignored)
!warp_score/
!warp_score/**
warp_score/__pycache__/
warp_score/**/__pycache__/
!scripts/
!scripts/**
scripts/__pycache__/
scripts/**/__pycache__/
!tests/
!tests/**
tests/__pycache__/
tests/**/__pycache__/
!third_party/
!third_party/**
third_party/__pycache__/
third_party/**/__pycache__/

# labels.csv is small enough to track
!labels.csv

# Skill metadata — contains default token placeholder, not committed
.claude/skills/upload-to-hf/SKILL.md
